# Veranico configuration reference.
#
# Names and non-secret development defaults only. Nothing needs this file to start:
# `make dev` passes the development values itself and generates the secrets it needs.
# A variable with an empty value is a secret or has no development default.
#
# Settings use the prefix VERANICO_ and "__" between a group and a field.
# The names the specification and the SDKs fix stay unprefixed.

# --- Unprefixed -----------------------------------------------------------------
# api (the product) or carrier (the mock carrier)
APP_ROLE=api
AGENT_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# Offline cube build only; never reaches the running service
CDS_API_KEY=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8580
STORAGE_EMULATOR_HOST=http://127.0.0.1:8590

# --- Core -----------------------------------------------------------------------
VERANICO_ENVIRONMENT=development
VERANICO_FIRESTORE_PROJECT=veranico-dev
VERANICO_STORAGE_BUCKET=veranico-dev
# local or gcs
VERANICO_BLOB_BACKEND=local
VERANICO_DATA_ROOT=.data
VERANICO_COOKIE_SIGNING_SECRET=
# JSON list of origins allowed to frame /embed/map; empty means none
VERANICO_FRAME_ANCESTORS=["http://127.0.0.1:3450"]
VERANICO_FRONTEND_DIST=../frontend/dist

# --- Access ---------------------------------------------------------------------
VERANICO_ACCESS__WORKSPACE_TTL_DAYS=14
VERANICO_ACCESS__ALLOWANCE_CONVERSATIONS=2
VERANICO_ACCESS__ALLOWANCE_MESSAGES=15
VERANICO_ACCESS__BOOSTED_CONVERSATIONS=6
VERANICO_ACCESS__BOOSTED_MESSAGES=60
VERANICO_ACCESS__ALLOWANCE_CODE=
VERANICO_ACCESS__IP_HASH_SALT=
# Integer micro-dollars (millionths of a US dollar)
VERANICO_ACCESS__DAY_CEILING_USD_MICROS=500000
VERANICO_ACCESS__MONTH_CEILING_USD_MICROS=10000000
# JSON object: model -> {input, output, cache_read, cache_write}, integer micro-dollars
# per million tokens. The default covers the default AGENT_MODEL.
# VERANICO_ACCESS__MODEL_PRICES=
VERANICO_ACCESS__API_KEY_RATE_PER_MINUTE=60
VERANICO_ACCESS__MAX_MESSAGE_CHARS=2000
VERANICO_ACCESS__CONVERSATION_TOKEN_BUDGET=200000

# --- Climate --------------------------------------------------------------------
# local or gcs
VERANICO_CLIMATE__STORE_BACKEND=local
VERANICO_CLIMATE__STORE_ROOT=.data/weather
VERANICO_CLIMATE__ARCHIVE_BASE_URL=https://archive-api.open-meteo.com
VERANICO_CLIMATE__GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
VERANICO_CLIMATE__ATTEMPT_TIMEOUT_SECONDS=10
VERANICO_CLIMATE__ATTEMPTS=4
VERANICO_CLIMATE__BACKOFF_BASE_SECONDS=0.5
VERANICO_CLIMATE__FIRST_YEAR=1950
VERANICO_CLIMATE__CUBE_CACHE_SIZE=1

# --- Pricing --------------------------------------------------------------------
VERANICO_PRICING__RISK_LOAD=0.3
VERANICO_PRICING__EXPENSE_LOAD=0.15
VERANICO_PRICING__SIMULATION_N=100000
VERANICO_PRICING__SIMULATION_SEED=42
VERANICO_PRICING__MIN_SEASONS=20
VERANICO_PRICING__CELL_CACHE_ENTRIES=64

# --- Delivery (quoting and carriers) -------------------------------------------
VERANICO_DELIVERY__WEBHOOK_SIGNING_SECRET=
VERANICO_DELIVERY__CARRIER_BASE_URL=http://127.0.0.1:8510
VERANICO_DELIVERY__WEBHOOK_CONNECT_TIMEOUT_SECONDS=2
VERANICO_DELIVERY__WEBHOOK_TOTAL_TIMEOUT_SECONDS=10
# relay (in process) or cloud_tasks
VERANICO_DELIVERY__DISPATCHER=relay
VERANICO_DELIVERY__ATTEMPT_LIMIT=5
VERANICO_DELIVERY__RETRY_WINDOW_SECONDS=3600
VERANICO_DELIVERY__RELAY_POLL_INTERVAL_SECONDS=1
VERANICO_DELIVERY__RELAY_BACKOFF_BASE_SECONDS=1
VERANICO_DELIVERY__RELAY_BACKOFF_CAP_SECONDS=30
VERANICO_DELIVERY__SWEEP_AGE_SECONDS=60
VERANICO_DELIVERY__INTERNAL_BASE_URL=http://127.0.0.1:8500
# disabled, token or oidc; disabled and token are refused in production
VERANICO_DELIVERY__INTERNAL_AUTH=token
VERANICO_DELIVERY__INTERNAL_TOKEN=
VERANICO_DELIVERY__OIDC_AUDIENCE=
VERANICO_DELIVERY__OIDC_INVOKER_EMAIL=
VERANICO_DELIVERY__TASKS_PROJECT=
VERANICO_DELIVERY__TASKS_LOCATION=us-central1
VERANICO_DELIVERY__TASKS_QUEUE=veranico-deliveries
# Must exceed the webhook total timeout
VERANICO_DELIVERY__TASKS_DISPATCH_DEADLINE_SECONDS=30
VERANICO_DELIVERY__CARRIER_FAIL_FIRST_ATTEMPT=false
VERANICO_DELIVERY__TIMESTAMP_TOLERANCE_SECONDS=300

# --- Assistant ------------------------------------------------------------------
# anthropic or scripted (no key needed)
VERANICO_ASSISTANT__MODEL_CLIENT=scripted
VERANICO_ASSISTANT__TOOL_CALL_LIMIT=10
# Provisional until plan 06 proposes the final values
VERANICO_ASSISTANT__MAX_OUTPUT_TOKENS=4096
VERANICO_ASSISTANT__MODEL_TIMEOUT_SECONDS=60
VERANICO_ASSISTANT__COMPACTION_THRESHOLD_TOKENS=60000
VERANICO_ASSISTANT__CHARS_PER_TOKEN=4

# --- Telemetry ------------------------------------------------------------------
# none, otlp or cloud_trace
VERANICO_TELEMETRY__EXPORTER=none
VERANICO_TELEMETRY__OTLP_ENDPOINT=
VERANICO_TELEMETRY__SERVICE_NAME=veranico
VERANICO_TELEMETRY__SERVICE_VERSION=0.0.0
