    },
    "cells": {
      "request": "GET /api/v1/regions/{id}/cells",
      "requests": 600,
      "virtual_users": 10,
      "max_duration": "10m"
    }
  },
  "thresholds": {
    "http_req_duration{scenario:quotes}": ["p(95)<2000"],
    "http_req_duration{scenario:cells}": ["p(95)<1000"],
    "unexpected_status": ["count==0"],
    "checks": ["rate==1"]
  }
}
